---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import poster from '../assets/boycott-poster.jpg';

const brands = (await getCollection('brands')).sort(
	(a, b) => a.data.order - b.data.order,
);

const entries = await Promise.all(
	brands.map(async (brand) => ({
		brand,
		Content: (await render(brand)).Content,
	})),
);
---

<section class="page-header">
	<h1>Com fer el boicot</h1>
	<p class="lead">
		El boicot funciona quan es manté i quan s'explica. Aquestes tres empreses
		són el punt on la campanya concentra l'esforç aquest curs.
	</p>
</section>

<figure class="poster poster--campaign">
	<Image
		src={poster}
		alt="Cartell de la campanya: Contra el genocidi i l'ocupació, boicot Israel i els seus còmplices"
		widths={[400, 800, 1200]}
		sizes="(max-width: 48rem) 90vw, 30rem"
	/>
	<figcaption>Descarrega el cartell i penja'l al teu barri o poble.</figcaption>
</figure>

<div class="brands">
	{entries.map(({ brand, Content }) => (
		<article class="brand" id={brand.id}>
			<header class="brand__head">
				<h2 class="brand__name">{brand.data.name}</h2>
				<p class="brand__sector">{brand.data.sector}</p>
			</header>

			<p class="brand__summary">{brand.data.summary}</p>

			<div class="brand__body">
				<Content />
			</div>

			{brand.data.alternatives.length > 0 && (
				<div class="brand__alternatives">
					<h3>Què pots fer</h3>
					<ul>
						{brand.data.alternatives.map((alt) => (
							<li>{alt}</li>
						))}
					</ul>
				</div>
			)}

			{brand.data.sources.length > 0 && (
				<div class="brand__sources">
					<h3>Fonts</h3>
					<ul>
						{brand.data.sources.map((source) => (
							<li>
								<a href={source.url} rel="noopener">
									{source.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</article>
	))}
</div>
