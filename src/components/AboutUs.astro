---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const organizations = await getCollection('organizations');
---

<section class="page-header">
	<h1>Qui som</h1>
	<p class="lead">
		Territoris Catalans amb Palestina coordina entitats de solidaritat de tot el
		territori: assemblees locals, sindicats, col·lectius d'estudiants i grups de
		barri que ja treballaven cadascun al seu poble.
	</p>
	<p>
		La coordinadora no substitueix cap entitat. Serveix per decidir campanyes
		conjuntes, compartir materials i arribar allà on una sola organització no
		arriba.
	</p>
</section>

<section class="entities">
	<h2>Entitats que hi participen</h2>
	<ul class="entities__list">
		{organizations.map((org) => {
			const Box = org.data.url ? 'a' : 'div';
			const link = org.data.url
				? { href: org.data.url, target: '_blank', rel: 'noopener' }
				: {};

			return (
				<li class="entity">
					<Box class="entity__box" {...link}>
						{org.data.logo && (
							<Image
								class="entity__logo"
								src={org.data.logo}
								alt=""
								widths={[200, 400]}
								sizes="200px"
							/>
						)}
						<span class="entity__name">
							{org.data.name}
							{org.data.url && (
								<svg
									class="entity__external"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									aria-hidden="true"
								>
									<path d="M7 17 17 7" />
									<path d="M9 7h8v8" />
								</svg>
							)}
						</span>
					</Box>
				</li>
			);
		})}
	</ul>
</section>
