---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import poster from '../assets/boycott-poster.jpg';

interface Props {
	base: string;
}

const { base } = Astro.props;

const brands = (await getCollection('brands')).sort(
	(a, b) => a.data.order - b.data.order,
);
const organizations = await getCollection('organizations');
---

<section class="hero">
	<div class="hero__text">
		<h1 class="hero__title">Boicot a Teva, Carrefour i ICL</h1>
		<p class="lead">
			Tres empreses que sostenen l'ocupació i el genocidi a Palestina. Deixar de
			comprar-hi és una decisió a l'abast de tothom, cada setmana, a la farmàcia
			i al supermercat.
		</p>
		<p class="actions">
			<a class="action" href={`${base}boicot/`}>
				Com fer el boicot
			</a>
			<a class="action action--quiet" href={`${base}qui-som/`}>
				Qui som
			</a>
		</p>
	</div>

	<figure class="poster">
		<Image
			src={poster}
			alt="Cartell de la campanya: Contra el genocidi i l'ocupació, boicot Israel i els seus còmplices"
			widths={[400, 800, 1200]}
			sizes="(max-width: 48rem) 90vw, 36rem"
		/>
	</figure>
</section>

<section class="companies">
	<h2>Les tres empreses</h2>
	<ul class="companies__list">
		{brands.map((brand) => (
			<li class="company">
				<h3 class="company__name">{brand.data.name}</h3>
				<p class="company__sector">{brand.data.sector}</p>
				<p class="company__summary">{brand.data.summary}</p>
				<a class="company__link" href={`${base}boicot/#${brand.id}`}>
					Per què la boicotegem
				</a>
			</li>
		))}
	</ul>
</section>

<section class="coalition">
	<h2>Una coordinadora d'entitats</h2>
	<p>
		Som entitats de solidaritat amb Palestina d'arreu dels Països Catalans que
		coordinem campanyes conjuntes. Aquesta n'és la principal.
	</p>
	<p class="count">
		<strong>{organizations.length}</strong>
		<span>entitats hi participen</span>
	</p>
	<a class="action action--quiet" href={`${base}qui-som/`}>
		Veure les entitats
	</a>
</section>
