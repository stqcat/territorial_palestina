---
import { getCollection } from 'astro:content';

interface Props {
	base: string;
}

const { base } = Astro.props;

const brands = (await getCollection('brands')).sort(
	(a, b) => a.data.order - b.data.order,
);
const organizations = await getCollection('organizations');
---

<section class="companies">
	<h2>Les tres empreses</h2>
	<ul class="companies__list">
		{brands.map((brand) => (
			<li class="company">
				<h3 class="company__name">{brand.data.name}</h3>
				<p class="company__sector">{brand.data.sector}</p>
				<p class="company__summary">{brand.data.summary}</p>
				<a class="company__link" href={`${base}boicot/#${brand.id}`}>
					Per què el boicot a {brand.data.name}?
				</a>
			</li>
		))}
	</ul>
</section>

<section class="coalition">
	<h2>Una coordinadora d'entitats</h2>
	<div class="coalition__row">
		<p class="count">
			<strong>{organizations.length}</strong>
			<span>entitats</span>
		</p>
		<p class="coalition__text">
			Som entitats de solidaritat amb Palestina d'arreu dels Països Catalans que
			coordinem campanyes conjuntes. Aquesta n'és la principal.
		</p>
		<a class="action" href={`${base}qui-som/`}>
			Totes les entitats
		</a>
	</div>
</section>
