---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import cartell from '../assets/cartell-boicot.jpg';

interface Props {
	base: string;
}

const { base } = Astro.props;

const marques = (await getCollection('marques')).sort(
	(a, b) => a.data.ordre - b.data.ordre,
);
const organitzacions = await getCollection('organitzacions');
---

<section class="hero">
	<div class="hero__text">
		<h1 class="hero__titol">Boicot a Teva, Carrefour i ICL</h1>
		<p class="lead">
			Tres empreses que sostenen l'ocupació i el genocidi a Palestina. Deixar de
			comprar-hi és una decisió a l'abast de tothom, cada setmana, a la farmàcia
			i al supermercat.
		</p>
		<p class="accions">
			<a class="accio" href={`${base}boicot/`}>
				Com fer el boicot
			</a>
			<a class="accio accio--discreta" href={`${base}qui-som/`}>
				Qui som
			</a>
		</p>
	</div>

	<figure class="cartell">
		<Image
			src={cartell}
			alt="Cartell de la campanya: Contra el genocidi i l'ocupació, boicot Israel i els seus còmplices"
			widths={[400, 800, 1200]}
			sizes="(max-width: 48rem) 90vw, 36rem"
		/>
	</figure>
</section>

<section class="empreses">
	<h2>Les tres empreses</h2>
	<ul class="empreses__llista">
		{marques.map((marca) => (
			<li class="empresa">
				<h3 class="empresa__nom">{marca.data.nom}</h3>
				<p class="empresa__sector">{marca.data.sector}</p>
				<p class="empresa__resum">{marca.data.resum}</p>
				<a class="empresa__enllac" href={`${base}boicot/#${marca.id}`}>
					Per què la boicotegem
				</a>
			</li>
		))}
	</ul>
</section>

<section class="coordinadora">
	<h2>Una coordinadora d'entitats</h2>
	<p>
		Som entitats de solidaritat amb Palestina d'arreu dels Països Catalans que
		coordinem campanyes conjuntes. Aquesta n'és la principal.
	</p>
	<p class="xifra">
		<strong>{organitzacions.length}</strong>
		<span>entitats hi participen</span>
	</p>
	<a class="accio accio--discreta" href={`${base}qui-som/`}>
		Veure les entitats
	</a>
</section>
