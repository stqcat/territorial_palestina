---
import '@fontsource/barlow/latin-400';
import '@fontsource/barlow/latin-600';
import '@fontsource/barlow/latin-700';
import '@fontsource/barlow-condensed/latin-700';
import '@fontsource/barlow-condensed/latin-800';
import '@fontsource/barlow-condensed/latin-900';
import '../styles/base.css';
import '../styles/label.css';
import Wordmark from '../components/Wordmark.astro';
import poster from '../assets/boycott-poster.jpg';

interface Props {
	title: string;
	description?: string;
	page: string;
}

const { title, description, page } = Astro.props;

// Absolute URLs: canonical links and social cards can't use relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(poster.src, Astro.site);

const menu = [
	{ href: '/boicot/', text: 'Boicot', id: 'boycott' },
	{ href: '/qui-som/', text: 'Qui som', id: 'about-us' },
	{ href: '/manifest/', text: 'Manifest', id: 'manifest' },
];
---

<html lang="ca">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Territoris Catalans amb Palestina" />
		<meta property="og:locale" content="ca_ES" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content={String(poster.width)} />
		<meta property="og:image:height" content={String(poster.height)} />
		<meta
			property="og:image:alt"
			content="Cartell de la campanya: Contra el genocidi i l'ocupació, boicot Israel i els seus còmplices. Teva, Carrefour i ICL. Palestina lliure"
		/>
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<div class="band">
			<div class="site">
				<header class:list={['header', { 'header--home': page === 'home' }]}>
					<nav class="menu" aria-label="Seccions">
						<ul>
							{menu.map((m) => (
								<li>
									<a
										href={m.href}
										aria-current={m.id === page ? 'page' : undefined}
									>
										{m.text}
									</a>
								</li>
							))}
						</ul>
					</nav>
					<Wordmark as={page === 'home' ? 'home' : 'link'} />
					{page === 'home' && <div class="wave" role="presentation" />}
				</header>

				<slot name="hero" />
			</div>
		</div>
		{page !== 'home' && <div class="wave wave--edge" role="presentation" />}

		<div class="site">
			<main class="content">
				<slot />
			</main>

			<footer class="footer">
				<p class="footer__name">Territoris Catalans amb Palestina</p>
				<p class="footer__note">
					Coordinadora d'entitats de solidaritat amb Palestina dels Països
					Catalans
				</p>
			</footer>
		</div>

		<div class="wave wave--edge wave--edge-up" role="presentation"></div>
		<div class="band band--foot">
			<div class="site">
				<p class="band__motto">Palestina lliure</p>
			</div>
		</div>
	</body>
</html>
