---
import '@fontsource/barlow/latin-400';
import '@fontsource/barlow/latin-600';
import '@fontsource/barlow-condensed/latin-600';
import '@fontsource/barlow-condensed/latin-700';
import '../styles/base.css';
import '../styles/label.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import poster from '../assets/boycott-poster.jpg';

interface Props {
	title: string;
	description?: string;
	page: string;
}

const { title, description, page } = Astro.props;

// Absolute URLs: canonical links and social cards can't use relative paths.
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(poster.src, Astro.site);

const menu = [
	{ href: '/boicot/', text: 'Boicot', id: 'boycott' },
	{ href: '/qui-som/', text: 'Qui som', id: 'about-us' },
	{ href: '/manifest/', text: 'Manifest', id: 'manifest' },
];
---

<html lang="ca">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Territoris Catalans amb Palestina" />
		<meta property="og:locale" content="ca_ES" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content={String(poster.width)} />
		<meta property="og:image:height" content={String(poster.height)} />
		<meta
			property="og:image:alt"
			content="Cartell de la campanya: Contra el genocidi i l'ocupació, boicot Israel i els seus còmplices"
		/>
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<div class="site">
			<header class="header">
				<a
					class="header__logo"
					href="/"
					aria-current={page === 'home' ? 'page' : undefined}
				>
					<Image
						src={logo}
						alt="Territoris Catalans amb Palestina"
						widths={[360, 720]}
						sizes="(max-width: 48rem) 75vw, 23rem"
					/>
				</a>

				<nav class="menu" aria-label="Seccions">
					<ul>
						{menu.map((m) => (
							<li>
								<a
									href={m.href}
									aria-current={m.id === page ? 'page' : undefined}
								>
									{m.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</header>

			<main class="content">
				<slot />
			</main>

			<footer class="footer">
				<p class="footer__name">Territoris Catalans amb Palestina</p>
				<p class="footer__note">
					Coordinadora d'entitats de solidaritat amb Palestina dels Països
					Catalans
				</p>
			</footer>
		</div>
	</body>
</html>
