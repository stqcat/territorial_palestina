---
import Base from '../layouts/Base.astro';
import { Content } from '../content/manifest.md';
---

<Base
	title="Manifest | Territoris Catalans amb Palestina"
	descripcio="Manifest de la coordinadora d'entitats de solidaritat amb Palestina dels Països Catalans."
	pagina="manifest"
>
	<section class="capcalera-pagina">
		<h1>Manifest</h1>
		<p class="lead">
			La declaració que comparteixen les entitats de la coordinadora.
		</p>
	</section>

	<div class="prosa">
		<Content />
	</div>
</Base>
